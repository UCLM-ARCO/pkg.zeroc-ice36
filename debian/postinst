#!/bin/bash
# see: dh_installdeb(1)

set -e

case "$1" in
    configure)
	ARCH=$(dpkg-architecture | grep "DEB_BUILD_ARCH=" | head -n1 | cut -f2 -d=  | tr -d " ")

	if [ "$ARCH" == "amd64" ]; then
	    mkdir -p /usr/lib/x86_64-linux-gnu/
	    ln -sf /usr/lib/x86_64-linux-gnu/libIceStormService.so.36 /usr/lib/x86_64-linux-gnu/libIceStormService.so
	fi

	if [ "$ARCH" == "i386" ]; then
	    mkdir -p /usr/lib/i386-linux-gnu/
	    ln -sf /usr/lib/i386-linux-gnu/libIceStormService.so.3.6.1 /usr/lib/i386-linux-gnu/libIceStormService.so
	    ln -sf /usr/bin/icebox32 /usr/bin/icebox
	fi

	;;

    abort-upgrade|abort-remove|abort-deconfigure)
	;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
	;;
esac

#DEBHELPER#

exit 0
